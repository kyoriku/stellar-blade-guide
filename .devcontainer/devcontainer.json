{
  "name": "stellar-blade-guide-dev",
  "dockerComposeFile": "docker-compose.yml",
  "service": "dev",
  "workspaceFolder": "/workspaces/stellar-blade-guide",
  // .venv's volume and uv's cache sit on different filesystems; copy mode skips the hardlink warning
  "containerEnv": {
    "UV_LINK_MODE": "copy"
  },
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    },
    // Same uv as the Dockerfile and ci.yml; bump all three together
    "ghcr.io/va-h/devcontainers-features/uv:1": {
      "version": "0.12.21"
    }
  },
  // Object form: steps run in parallel, so one failing doesn't skip the others.
  // npm 11 for min-release-age (Node 22's npm 10 ignores it; 12 blocks install scripts, unlike Railway's build).
  // Exact because npm 10 runs this install. Same version in the Dockerfile and ci.yml
  "postCreateCommand": {
    "claude": "curl -fsSL https://claude.ai/install.sh | bash",
    "server": "cd server && uv sync",
    "client": "npm install -g npm@11.21.1 && cd client && npm ci && cd /workspaces/stellar-blade-guide/e2e && npm ci && ./node_modules/.bin/playwright install --with-deps chromium"
  },
  // compose publishes the ports, so VS Code shouldn't forward its own copies
  "otherPortsAttributes": {
    "onAutoForward": "ignore"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "anthropic.claude-code"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/workspaces/stellar-blade-guide/server/.venv/bin/python"
      }
    }
  },
  "remoteUser": "vscode"
}