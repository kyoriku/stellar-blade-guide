# Gitignored screenshot sources; deploys build from git, so local builds skip them too
client/public/assets/images

# Finder junk stays out of the build context and dist/
**/.DS_Store

# load_dotenv() would fill unset vars from a baked-in .env, DEBUG and prod credentials included
**/.env

# Local installs, caches, and build output; the image builds its own
**/node_modules
**/.venv
client/dist
**/__pycache__

# Never copied into the image; ignoring them keeps the build context small
.git
.devcontainer